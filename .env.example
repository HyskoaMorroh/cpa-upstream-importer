# CPA upstream-importer 环境变量模板
# 复制为 .env 并填入真实值：cp .env.example .env
# 本文件只放占位值。真实 .env 已在 .gitignore 里，不要提交。
#
# 说明：本文件对应仓库自带的 docker-compose.yml（独立部署）。
# 线上整栈（/opt/deploy/docker-compose.yml）变量名略有不同的地方已在注释里标出。

# ══════════════════════════════════════════════════════════════════════
# 一、必填
# ══════════════════════════════════════════════════════════════════════

# CPA 的 config.yaml 在宿主机上的绝对路径。
# compose 用 ${CONFIG_PATH:?} —— 不填 `docker compose up` 直接报错退出。
# 只挂这一个文件（不挂整个目录），写回是就地 O_TRUNC 覆写，CPA 才能读到新内容。
CONFIG_PATH=/opt/deploy/config.yaml

# ══════════════════════════════════════════════════════════════════════
# 二、CPA 连接与鉴权
# ══════════════════════════════════════════════════════════════════════

# CPA 的地址。写回后主动 PUT 让 CPA 立即重载。
# 同一个 compose 栈里填服务名；独立部署填宿主可达地址（如 http://127.0.0.1:8317）。
CPA_UPSTREAM_URL=http://cli-proxy-api:8317

# CPA 管理接口令牌（CPA 后台管理密码的原文，不是哈希）。
# 不填的后果：「按 CPA 真实运行状态定优先级」静默失效 —— 健康分退回
# 静态检测分，日志只有一行「CPA 运行时数据不可用」（修改要求第 3⑶ 条）。
# 线上整栈 compose 里写的是 CPA_MANAGEMENT_TOKEN: "${CPA_MANAGEMENT_PASSWORD}"，
# 即 .env 里填 CPA_MANAGEMENT_PASSWORD 也行，两者取其一。
CPA_MANAGEMENT_TOKEN=
# CPA_MANAGEMENT_PASSWORD=

# 投喂台访问令牌。留空 = 每次启动随机生成并打印到日志（重启就变），
# 也可以直接用 CPA 后台管理密码登录。建议填一个固定的长随机串。
IMPORTER_TOKEN=

# 仅 cli.py（命令行批量导入）用：CPA 管理密钥与客户端 Key。容器里的网页不读这两个。
# MGMT=
# CPA_CLIENT_KEY=

# ══════════════════════════════════════════════════════════════════════
# 三、镜像、端口与运行用户
# ══════════════════════════════════════════════════════════════════════

# IMAGE=swhesong/cpa-upstream-importer:latest   # 默认；改成 ghcr.io/<owner>/... 也行
# 默认 always：每次 up 都检查远程新镜像。本地改代码自己构建时设 build。
# PULL_POLICY=always
# CONTAINER_NAME=cpa-upstream-importer          # 容器名；mihomo 两个容器名以它为前缀
# BIND_ADDR=127.0.0.1                            # 只绑回环，公网走 nginx 反代
# HOST_PORT=8765
# 必须与宿主上 config.yaml 的属主一致，否则写回 PermissionError。
# 查属主：stat -c '%u:%g' /opt/deploy/config.yaml
# IMPORTER_UID=0
# IMPORTER_GID=0
# 容器内存上限。一次全量重探峰值约 480MB，512M 会被 OOM 杀掉（任务全丢）。
# IMPORTER_MEMORY_LIMIT=1G                       # 旧名 MEMORY_LIMIT 仍兼容
# IMPORTER_RESTART=unless-stopped

# 反代可信来源。nginx 在宿主机、importer 在容器里时，容器看到的对端是 Docker
# 网关地址（如 172.18.0.1），不是回环。不把它列为可信，X-Forwarded-For 会被
# 忽略，所有访客都被当成同一个 IP —— 服务端「失败 5 次封 30 分钟」会连坐所有人。
# 逗号分隔的 IP 或 CIDR。查网关：docker network inspect <网络名> | grep Gateway
# IMPORTER_TRUSTED_PROXY_PEERS=172.18.0.1

# ══════════════════════════════════════════════════════════════════════
# 四、日志
# ══════════════════════════════════════════════════════════════════════

# DEBUG 输出每次上游请求详情，便于排查探测失败与写回异常；INFO 只记关键里程碑。
IMPORTER_LOG_LEVEL=INFO
# 1 = 同时写 /app/logs/importer-时间戳.log（compose 已把它挂到宿主 ./logs）。
IMPORTER_LOG_TO_FILE=0
# IMPORTER_LOG_DIR=./logs                        # 宿主上的日志目录

# ══════════════════════════════════════════════════════════════════════
# 五、探测与代理
# ══════════════════════════════════════════════════════════════════════

# 探测「直连不通 → 改走代理重试」用的代理，逗号分隔可给多个。
# 留空时回落到内置的 http://mihomo:7890 与 http://127.0.0.1:7890。
# PROBE_PROXY=http://mihomo:7890

# 探测超时（秒）。单个上游请求的上限，与单个协议段（claude/codex/gemini/openai）
# 的总时限。留空用代码默认值。站点多且常有挂死站时，调小段时限能明显缩短全量检测。
# PROBE_REQUEST_TIMEOUT=
# PROBE_SECTION_DEADLINE=

# CPA / CPAMP 源码漂移检测：从 GitHub 拉源码核对请求画像是否过期。
# 国内 VPS 直连 GitHub 常超时，填代理（mihomo 起来后用 http://mihomo:7890）。
# DRIFT_PROXY=
# CPA_SOURCE_REF=main                            # 核对 CLIProxyAPI 的哪个分支/标签
# CPAMP_SOURCE_REF=main                          # 核对 CPA Manager Plus 的哪个分支/标签
# 可选：把本地 CLIProxyAPI 源码只读挂进来，漂移检测更精确（两项同时设）。
# CPA_SOURCE=/opt/deploy/cpa-src/CLIProxyAPI
# CPA_SOURCE_ROOT=/cpa-source

# ══════════════════════════════════════════════════════════════════════
# 六、mihomo 代理（docker compose --profile mihomo up -d 才会启动）
# ══════════════════════════════════════════════════════════════════════

# 9090 RESTful API 鉴权密钥。留空则不设鉴权，同网段任何容器都能切出口、读节点。
MIHOMO_SECRET=

# 订阅 URL（含 token，私密值）。两种写法可混用，同名时 MIHOMO_SUB_<名称> 优先。
# provider 名 = 名称部分转小写；节点组的 use 列表与订阅域名 DIRECT 规则都按这里生成。
# 一个订阅都不配时 mihomo-init 会非零退出，代理不会启动。
MIHOMO_SUB_WOG=https://sub.example.com/api/v1/client/subscribe?token=REPLACE_ME
# MIHOMO_SUB_WOGB=https://sub2.example.net/link/REPLACE_ME?clash=1
# MIHOMO_SUBSCRIPTIONS=wog=https://sub.example.com/...;backup=https://sub2.example.net/...

# 订阅或 MIHOMO_SECRET 变化时 mihomo-init 会自动重建配置（先备份）。
# 设 1 = 无条件重建：2026-09-27 之前建的老卷第一次改订阅时需要，用完清空。
# MIHOMO_FORCE_REBUILD=

# 端口映射（只绑回环；容器间走服务名 mihomo:7890，不依赖这两个映射）
# MIHOMO_BIND=127.0.0.1
# MIHOMO_MIXED_PORT=7890
# MIHOMO_API_PORT=9090

# 健康检查参数（mihomo 容器内的 healthcheck.sh 用）
# MIHOMO_GROUP=PROXY                             # 节点全挂时切 DIRECT 的那个组
# MIHOMO_PROBE_URL=https://www.gstatic.com/generate_204
# MIHOMO_STATE_FILE=/tmp/mihomo-egress-state

# Provider permission is required before ANY upstream probe (including /models).
# Empty/missing policy means passive configuration analysis. Never treat a
# provider's numerical ban threshold as a safe request allowance.
IMPORTER_PROBE_POLICY_FILE=/backups/probe-policy.json
IMPORTER_PROBE_LEDGER=/backups/probe-policy.sqlite3
