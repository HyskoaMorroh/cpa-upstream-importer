# CPA upstream-importer 环境变量模板
# 复制为 .env 并填入真实值

# === CPA 连接配置 ===
CPA_UPSTREAM_URL=http://cli-proxy-api:8317
IMPORTER_TOKEN=
IMPORTER_CONFIG=/data/config.yaml
IMPORTER_BACKUP_DIR=/backups
IMPORTER_HOST=0.0.0.0
IMPORTER_PORT=8765

# === mihomo 代理配置 ===
# RESTful API 鉴权密钥（留空则不设鉴权，同网段容器可直连 9090）
MIHOMO_SECRET=

# 订阅 URL（含 token，私密值）
# 格式：MIHOMO_SUB_<大写名称>=URL
MIHOMO_SUB_WOG=https://vpn.example.com
MIHOMO_SUB_WOGB=https://www.example.net/api/v1/client/subscribe?token=REPLACE_ME

# 或用统一格式（分号或换行分隔）：
# MIHOMO_SUBSCRIPTIONS=wog=https://...;wogb=https://...
