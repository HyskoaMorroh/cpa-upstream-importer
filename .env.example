# 投喂台 · 环境变量样例
#
#   cp .env.example .env && $EDITOR .env
#
# `.env` 已在 .gitignore 里 —— 别把填好的那份提交上去。
# 本文件不含任何真实凭据，只有占位符与说明。

# ── 必填 ────────────────────────────────────────────────────
#
# CPA 的 config.yaml 在**宿主机上**的绝对路径。
# 它会以单文件 bind mount 挂进容器的 /data/config.yaml。
#
# 注意这个文件含明文上游 Key 与管理密钥哈希 —— 本服务对它有写权限。
CONFIG_PATH=/opt/deploy/config.yaml


# ── 镜像来源 ────────────────────────────────────────────────
#
# 拉现成的多架构镜像（支持 amd64 / arm64）。把 <owner> 换成实际的：
#   IMAGE=ghcr.io/<owner>/cpa-upstream-importer:latest
#   IMAGE=<dockerhub-user>/cpa-upstream-importer:latest
#
# Docker Hub 上的镜像名由 CI 的 DOCKERHUB_IMAGE 仓库变量决定，可能与
# GitHub 仓库名不同 —— 拉之前先看 Actions 日志里 metadata 步骤输出的 tag。
#
# 留空则用本地构建的 cpa-upstream-importer:local。
#IMAGE=

# 用现成镜像时改成 missing，否则 compose 会尝试本地构建。
# 本地构建时保持 build。
#PULL_POLICY=build


# ── 文件属主：不对齐会导致写回失败 ──────────────────────────
#
# 必须与 CONFIG_PATH 那个文件的属主一致，否则容器写回时 PermissionError。
# 查：  stat -c '%u:%g' /opt/deploy/config.yaml
# 通常 root 拥有的配置就是 0:0。
IMPORTER_UID=0
IMPORTER_GID=0


# ── 监听与暴露 ──────────────────────────────────────────────
#
# 只发布到宿主回环地址。**改成 0.0.0.0 等于把它暴露到公网** ——
# 这个界面持有明文上游 Key 且能改写 config.yaml。
# 要从外部访问，请用 nginx 反代并在那一层加 TLS + 访问控制
# （见 deploy/nginx-snippet.conf），不要改这一项。
BIND_ADDR=127.0.0.1
HOST_PORT=8765


# ── CPA 管理端点 ────────────────────────────────────────────
#
# 写回后主动 PUT 到这里让 CPA 立即生效。
#   同一个 compose 栈内  ->  http://cli-proxy-api:8317（服务名）
#   独立部署、CPA 在宿主  ->  http://127.0.0.1:8317
#
# **不要填公网域名。** 若你的 CPA 在 Cloudflare 后面，管理端点的 PUT
# 会被拦成 403 error code 1010 —— 那是 CF 的码，不是 CPA 拒绝了配置，
# 请求根本没到 CPA。详见 README「CPA 地址千万别填公网域名」。
CPA_UPSTREAM_URL=http://127.0.0.1:8317


# ── 可选 ────────────────────────────────────────────────────
#
# 固定登录 token。不设则每次重启随机生成并打印到日志。
# 留空也能用 —— 直接拿 CPA 后台的**管理密码**登录（服务端 bcrypt 比对）。
# 要生成一个：  openssl rand -hex 20
#IMPORTER_TOKEN=

# 容器名与内存上限
#CONTAINER_NAME=cpa-upstream-importer
#MEMORY_LIMIT=512M
