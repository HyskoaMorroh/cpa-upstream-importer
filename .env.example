# CPA upstream-importer 环境变量模板
# 复制为 .env 并填入真实值

# === 必填：CPA 的 config.yaml 在宿主机上的绝对路径 ===
# compose 用 ${CONFIG_PATH:?} —— 不填 `docker compose up` 直接报错退出。
# 只挂这一个文件（不挂整个目录），写回是就地 O_TRUNC 覆写，CPA 才能读到新内容。
CONFIG_PATH=/opt/deploy/config.yaml

# === CPA 连接配置 ===
CPA_UPSTREAM_URL=http://cli-proxy-api:8317

# CPA 管理接口令牌（后台管理密码）。
# 不填的后果：导入时「按 CPA 真实运行状态定优先级」静默失效 —— 健康分退回
# 静态检测分，而日志只有一行「CPA 运行时数据不可用」。用户第 3⑶ 条要求的就是
# 前者。填 CPA 后台的管理密码即可。
CPA_MANAGEMENT_TOKEN=

# 投喂台访问令牌。留空 = 每次启动随机生成并打印到日志（重启就变）。
# 建议填一个固定值，否则每次 `up -d` 后都要去日志里翻新令牌。
IMPORTER_TOKEN=
IMPORTER_CONFIG=/data/config.yaml
IMPORTER_BACKUP_DIR=/backups
IMPORTER_HOST=0.0.0.0
IMPORTER_PORT=8765

# === 可选：镜像与发布 ===
# IMAGE=swhesong/cpa-upstream-importer:latest   # 默认；改成 ghcr.io/<owner>/... 也行
# PULL_POLICY=missing                            # build = 本地构建而不拉镜像
# BIND_ADDR=127.0.0.1                            # 只绑回环，公网走 nginx
# HOST_PORT=8765
# IMPORTER_UID=0                                 # 必须与 config.yaml 属主一致，否则写回 PermissionError
# IMPORTER_GID=0
# MEMORY_LIMIT=512M

# === mihomo 代理配置（docker compose --profile mihomo up -d 才会启动）===
# RESTful API 鉴权密钥（留空则不设鉴权，同网段容器可直连 9090）
MIHOMO_SECRET=

# 订阅 URL（含 token，私密值）
# 格式：MIHOMO_SUB_<大写名称>=URL
MIHOMO_SUB_WOG=https://vpn.example.com
MIHOMO_SUB_WOGB=https://www.example.net/api/v1/client/subscribe?token=REPLACE_ME

# 或用统一格式（分号或换行分隔）：
# MIHOMO_SUBSCRIPTIONS=wog=https://...;wogb=https://...

# 可选：端口映射与强制重建
# MIHOMO_BIND=127.0.0.1
# MIHOMO_MIXED_PORT=7890
# MIHOMO_API_PORT=9090
# MIHOMO_FORCE_REBUILD=1                         # 置 1 会备份并重写 mihomo 的 config.yaml
