# CPA 上游灌输工具 · 环境变量配置示例
#
# 部署方式：
#   1. 复制本文件为 .env，填写真实值
#   2. docker compose up -d
#
# 安全提醒：.env 含明文凭据（订阅 URL、token），已在 .gitignore 排除，
#           切勿提交版本库。

# ── Importer 服务 ───────────────────────────────────────────────────
# Bearer token（可选）。不设则每次启动随机生成，或直接用 CPA 后台密码登录。
# 生成方式：openssl rand -hex 20
IMPORTER_TOKEN=

# UID/GID：必须与宿主机 config.yaml 的属主一致，否则写回 PermissionError。
# 查询命令：stat -c '%u:%g' /opt/deploy/config.yaml
IMPORTER_UID=0
IMPORTER_GID=0

# ── mihomo 代理 ─────────────────────────────────────────────────────
# API 鉴权密钥（可选）：9090 RESTful API 用。不设的话同一 Docker 网络内的
# 容器可无鉴权访问，但外部访问已由 nginx 阻断（127.0.0.1:9090 不对外）。
# 生成方式：openssl rand -hex 20
MIHOMO_SECRET=

# 订阅地址（必填）：含 token，mihomo 从这两个 URL 拉取节点配置。
# 格式：https://域名/路径?token=xxx
# 示例（脱敏）：https://vpn.example.com
MIHOMO_SUB_WOG=
MIHOMO_SUB_WOGB=
